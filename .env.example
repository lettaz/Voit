# ============================================
# Voit – Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Convex (auto-populated by `npx convex dev` in .env.local)
# CONVEX_DEPLOYMENT=dev:your-deployment-name
# VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Backend
PORT=3088
FRONTEND_URL=http://localhost:8080
BETTER_AUTH_SECRET=change-me-to-a-random-secret
BETTER_AUTH_URL=http://localhost:3088

# Google OAuth (for Better Auth – configure in Step 2)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ElevenLabs
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_AGENT_ID=your-agent-id
# ELEVENLABS_VOICE_ID=your-voice-id

# Twilio (via ElevenLabs – set up later)
# TWILIO_PHONE_NUMBER_ID=your-phone-number-id

# Firecrawl – Provider Discovery
# Get your API key at https://firecrawl.dev
# FIRECRAWL_API_KEY=your-firecrawl-api-key

# Debug Mode
# When true, all outbound calls use DEBUG_PHONE_NUMBER instead of real provider numbers
# Provider data still stores real numbers
DEBUG_MODE=true
DEBUG_PHONE_NUMBER=+15551234567
